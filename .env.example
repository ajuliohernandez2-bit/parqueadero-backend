# Copia este archivo a ".env" y completa los valores. NUNCA subas el .env a GitHub.

PORT=3000
NODE_ENV=development

# Local:  mongodb://localhost:27017/parqueadero
# Atlas:  mongodb+srv://USUARIO:CLAVE@cluster.mongodb.net/parqueadero
MONGO_URI=mongodb://localhost:27017/parqueadero

# Genera uno largo y aleatorio, por ejemplo con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_seguro
JWT_EXPIRES_IN=8h

# Origenes del frontend permitidos por CORS (separados por coma).
# Vacio = se permite cualquier origen (solo para desarrollo).
CLIENT_URL=http://localhost:5173

# Intentos maximos de login/registro por IP cada 15 minutos
AUTH_RATE_LIMIT=30
